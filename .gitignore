*.fw

# The directory Mix will write compiled artifacts to (umbrella-wide).
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads dependency sources to (umbrella-wide).
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests. ExUnit's `@tag :tmp_dir` writes
# under the *app's* tmp/, not the umbrella root's, so both forms are needed.
/tmp/
/apps/*/tmp/

# Scratch/dev-only working files, not part of the shipped tree.
/.dev/

# /phx:review stages the detected requirements source here before handing it
# to the verifier agent — it's a verbatim copy of the plan (or a fetched
# issue), so committing it duplicates a file already in the tree.
.claude/plans/*/reviews/.requirements-input.md

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# ElixirLS build/cache artifacts.
/.elixir_ls/
.claude/home-backup/
