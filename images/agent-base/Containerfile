# glibc/Debian on purpose: the Claude installer's musl selection is undocumented, and
# pip wheels (dbus-fast, lxml) ship manylinux aarch64 builds. The BEAM comes from hexpm
# because bookworm only packages OTP 25 and `vagus` must speak dist to the board's OTP 29;
# the final stage uses the same bookworm snapshot so the copied binaries find their glibc.
ARG DEBIAN_TAG=bookworm-20260713-slim
ARG BEAM_IMAGE=docker.io/hexpm/elixir:1.20.2-erlang-29.0.3-debian-bookworm-20260713-slim

FROM ${BEAM_IMAGE} AS beam

# pylzma (an edlclient dependency) has no wheel, so the compiler stays in this stage.
FROM docker.io/library/debian:${DEBIAN_TAG} AS pybuild
ARG EDL_COMMIT=1cda1a616748d608667b2d13b73a28d3197ceb45
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl gcc libc6-dev python3-dev python3-venv libusb-1.0-0-dev \
 && rm -rf /var/lib/apt/lists/*
# PyPI's `edl` is an unrelated edit-decision-list library; the Qualcomm tool is
# bkerler/edl (`edlclient`), never published there. The tarball skips the Loaders
# submodule (firehose programmers are passed with --loader instead).
# requirements.txt pins every transitive dependency (edlclient itself excluded) and is
# passed as constraints too, so a floating dep cannot change under the same EDL_COMMIT.
COPY requirements.txt /tmp/requirements.txt
RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt -c /tmp/requirements.txt \
      "edlclient @ https://github.com/bkerler/edl/archive/${EDL_COMMIT}.tar.gz" \
 && find /opt/venv -name __pycache__ -prune -exec rm -rf {} +

# vagus-memory is copied straight into site-packages: building it as a wheel would pull
# an unpinned setuptools into the build. Its deps are already in requirements.txt.
COPY vagus-memory/vagus_memory /tmp/vagus_memory
RUN cp -r /tmp/vagus_memory "$(/opt/venv/bin/python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/"

# The model is baked here because nothing may be downloaded on the board at runtime.
ARG MEMORY_MODEL=BAAI/bge-small-en-v1.5
RUN /opt/venv/bin/python3 -c 'import sys; from fastembed import TextEmbedding; TextEmbedding(model_name=sys.argv[1], cache_dir="/opt/fastembed")' "$MEMORY_MODEL" \
 && find /opt/venv -name __pycache__ -prune -exec rm -rf {} +

FROM docker.io/library/debian:${DEBIAN_TAG}

ARG CLAUDE_VERSION=2.1.289
ARG VERIFY_CLAUDE=1

# libtinfo6/libstdc++6 (beam.smp), libssl3 (crypto NIF), zlib1g, libsctp1 (gen_sctp).
# dnsmasq-base: the binary without a service. openssh-server: its host keys are
# generated at install, so they are removed rather than shared by every board.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libtinfo6 libstdc++6 libssl3 zlib1g libsctp1 \
      ca-certificates curl bash tmux git jq ripgrep procps tini util-linux less nano \
      file xz-utils unzip socat iproute2 iputils-ping \
      bluez picocom usbutils usbip dnsmasq-base openocd adb fastboot openssh-server \
      python3 python3-venv libusb-1.0-0 \
 && rm -f /etc/ssh/ssh_host_* \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /var/log/apt /var/log/dpkg.log

# bookworm only ships psql 15, older than the board's Postgres 17 memory app. The PGDG key
# is checked by hash so a swapped key on the mirror fails the build instead of being trusted.
ARG PGDG_KEY_SHA256=0144068502a1eddd2a0280ede10ef607d1ec592ce819940991203941564e8e76
RUN install -d /usr/share/postgresql-common/pgdg \
 && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
      https://www.postgresql.org/media/keys/ACCC4CF8.asc \
 && echo "$PGDG_KEY_SHA256  /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc" | sha256sum -c - \
 && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client-17 \
 && psql --version | grep -q ' 17\.' \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /var/log/apt /var/log/dpkg.log

COPY --from=beam /usr/local/lib/erlang /usr/local/lib/erlang
COPY --from=beam /usr/local/lib/elixir /usr/local/lib/elixir
RUN for b in erl erlc escript epmd run_erl to_erl ct_run dialyzer typer; do \
      ln -s ../lib/erlang/bin/$b /usr/local/bin/$b; done \
 && for b in elixir elixirc iex mix; do \
      ln -s ../lib/elixir/bin/$b /usr/local/bin/$b; done

# Without a UTF-8 locale Elixir runs with latin1 filename encoding and warns on every start.
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

RUN erl -noshell -eval 'io:format("~s~n",[erlang:system_info(otp_release)]), halt().' | grep -qx 29 \
 && elixir -e 'IO.puts System.version()' | grep -qx 1.20.2 \
 && elixir -e ':crypto.strong_rand_bytes(1)'

# /work is the trusted project dir: Claude never saves workspace trust for $HOME.
RUN groupadd --gid 1000 agent \
 && useradd --uid 1000 --gid 1000 --create-home --home-dir /home/agent --shell /bin/bash agent \
 && mkdir /work \
 && chown agent:agent /work

COPY --from=pybuild --chown=1000:1000 /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN python3 -c 'import serial, bleak, usb, pyftdi, edlclient' && edl --help >/dev/null

ARG MEMORY_MODEL=BAAI/bge-small-en-v1.5
COPY --from=pybuild --chown=1000:1000 /opt/fastembed /opt/fastembed
COPY --chmod=755 vagus-memory/bin/vagus-memory vagus-memory/bin/memory /usr/local/bin/
ENV FASTEMBED_CACHE_PATH=/opt/fastembed VAGUS_MEMORY_MODEL=${MEMORY_MODEL} HF_HUB_OFFLINE=1
# Proves the baked model loads with the network unused, as it must on the board.
RUN python3 -I -c 'from vagus_memory.embed import FastEmbedder; import vagus_memory.server, vagus_memory.cli; v = FastEmbedder().embed(["probe"])[0]; assert len(v) > 0, v' \
 && memory --help >/dev/null

USER agent
RUN curl -fsSL https://claude.ai/install.sh | bash -s "$CLAUDE_VERSION"

# Symlink so root and non-login `podman exec` find it without the user PATH.
USER root
RUN ln -s /home/agent/.local/bin/claude /usr/local/bin/claude

# The pin must not drift at runtime.
ENV DISABLE_UPDATES=1 DISABLE_AUTOUPDATER=1
ENV PATH=/home/agent/.local/bin:$PATH

# Guarded so a QEMU cross build, where the native binary may not execute, can skip it.
# The output is `<version> (Claude Code)`; matching the version plus its space keeps
# 2.1.2890 from passing for 2.1.289.
RUN if [ "$VERIFY_CLAUDE" = 1 ]; then \
      v=$(claude --version); \
      case "$v" in "$CLAUDE_VERSION "*) ;; \
        *) echo "claude version mismatch: wanted $CLAUDE_VERSION, got $v" >&2; exit 1 ;; esac; \
    fi

USER agent
WORKDIR /work
CMD ["bash"]
