#!/usr/bin/env bash
# A worker gets its own config dir with only the login in it: the orchestrator's own
# dir holds every session transcript (so every `vagus eval` result), and a live session
# must not share its config dir with another CLI.
set -euo pipefail
: "${CLAUDE_CONFIG_DIR:?}"

[ $# -eq 1 ] && [[ $1 =~ ^[A-Za-z0-9_.-]+$ ]] && [[ $1 != .* ]] \
  || { echo "usage: worker-config <task>   (letters, digits, _ . -)" >&2; exit 64; }
task=$1
root=/data/worker-configs
dir=$root/$task
creds=$CLAUDE_CONFIG_DIR/.credentials.json
[ -r "$creds" ] || { echo "worker-config: no login at $creds" >&2; exit 1; }

umask 077
mkdir -p "$root"

# Unlike the task work dir (mounted rw at /work, so the worker controls what is in it),
# nothing under $root is worker-writable except that one worker's own /claude. A
# symlink here means something replaced a path we own; fail rather than follow or heal it.
refuse_symlink() {
  [ ! -L "$1" ] || { echo "worker-config: $1 is a symlink, refusing" >&2; exit 1; }
}
refuse_symlink "$root"
mkdir -p "$dir"
refuse_symlink "$dir"
refuse_symlink "$dir/.credentials.json"
refuse_symlink "$dir/.claude.json"
refuse_symlink "$dir/CLAUDE.md"
[[ $(readlink -f "$dir") == "$root/$task" ]] \
  || { echo "worker-config: $dir resolves outside $root, refusing" >&2; exit 1; }
mkdir -p "$dir/projects"
refuse_symlink "$dir/projects"
chmod 0700 "$dir"

# Re-running refreshes only the login; the worker's own state is left alone.
install -m 0600 "$creds" "$dir/.credentials.json"
# $dir is the one place the worker can write, so it can swap a path for a symlink after
# any check above. Everything is therefore read from a private copy made with `cp -P`
# (never follows) and written to a scratch file beside $dir, then renamed over the target:
# a rename replaces a symlink instead of following it (`mv -T`: a directory symlink at the
# target must not swallow the file).
scratch=$(mktemp -d "$root/.wc.XXXXXX")
trap 'rm -rf "$scratch"' EXIT
cfg=$scratch/in.json
if [ -e "$dir/.claude.json" ] || [ -L "$dir/.claude.json" ]; then
  cp -P "$dir/.claude.json" "$cfg"
  { [ -f "$cfg" ] && [ ! -L "$cfg" ]; } \
    || { echo "worker-config: $dir/.claude.json is not a regular file, refusing" >&2; exit 1; }
else
  jq -n '{hasCompletedOnboarding: true, remoteDialogSeen: true,
          projects: {"/work": {hasTrustDialogAccepted: true}}}' > "$cfg"
fi

# Applied on every run, with `=`, so a changed DSN or older configs (made before the
# memory DB existed) are refreshed; the rest of the worker's state is left alone. The DB
# is board-local and trust-auth, so the DSN carries no secret.
# The default must match Vagus.Network.Agentnet.memory_ip/0.
dsn=${VAGUS_MEMORY_DSN:-postgresql://agent@172.30.40.2/memory}
out=$(mktemp "$scratch/out.XXXXXX")
jq --arg dsn "$dsn" --arg task "$task" \
  '.mcpServers["vagus-memory"] = {command: "vagus-memory",
     env: {VAGUS_MEMORY_DSN: $dsn, VAGUS_TASK: $task}}' "$cfg" > "$out"
mv -T -- "$out" "$dir/.claude.json"

# User-scope memory file of this CLAUDE_CONFIG_DIR: the one place a worker reads rules
# from that its writable /work cannot shadow. Rewritten each run so the rule stays current.
out=$(mktemp "$scratch/out.XXXXXX")
cat > "$out" <<'RULES'
# Board memory

The `vagus-memory` MCP server is this board's shared, persistent memory.

- Before you start, `recall` what earlier tasks learned about this work.
- As you go, `journal` what you tried and what happened, so a restart can resume.
- Before you report, `remember` what you learned that the next task would need.
- Never store secrets in memory: no passwords, tokens, keys or cookies.
RULES
mv -T -- "$out" "$dir/CLAUDE.md"

# Ownership matters only when run as root (`podman exec` without `--user agent`).
if [ "$(id -u)" = 0 ]; then
  chown 1000:1000 "$root" "$dir"
  chown -R 1000:1000 "$dir"
fi

echo "/data/addons/data/agent_orchestrator/worker-configs/$task"
